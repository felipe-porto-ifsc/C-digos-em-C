#include <stdio.h>
#define tam_vet 5

void zero(int vetor[], int tamanho)
{
    int i;
    for (i=0; i<tamanho; i++)
    {
        vetor[i] = 0;
    }
}

void imprimir_vetor(int vetor[], int tamanho)
{
    int i;
    for (i=0; i<tamanho; i++)
    {
        printf("| indice = %d, valor = %d |\n", i, vetor[i]);
    }
    printf("\n\n");
    zero(vetor, tamanho);
    for (i=0; i<tamanho; i++)
    {
        printf("| indice = %d, valor = %d |\n", i, vetor[i]);
    }

}

float calcular_media_vet(int vetor[], int tamanho)
{
    int i, soma_ac;
    float media;

    soma_ac = 0;
    for (i=0; i<tamanho; i++)
    {
        soma_ac = soma_ac + vetor[i];
    }
    media = (float)soma_ac / tamanho;
    return media;
}

int main() {
    int notas_turma_b[6]={9,9,9,9,9,9};
    int notas[tam_vet]={7,6,5,3,1};
    float media;

    media = calcular_media_vet(notas, tam_vet);
    printf("media = %.2f\n", media);
    media = calcular_media_vet(notas_turma_b, 6);
    printf("media = %.2f\n\n", media);
    
    imprimir_vetor(notas, tam_vet);
    printf("\n");
    imprimir_vetor(notas_turma_b, 6);

    return 0;
}
